#!/usr/bin/env bash
# Pre-commit hook for Aziz Academy.
# Activate with:  git config core.hooksPath .githooks
#
# Runs:
#   1. JSON quiz pack validator (cheap; ~1s)
#   2. flutter analyze (slow; ~30s — skipped for non-Dart-only commits)
#
# Bypass with `git commit --no-verify` if you must (try not to).
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [[ -n "$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^assets/data/.*\.json$' || true)" ]]; then
  echo "→ Validating staged quiz packs..."
  PYTHONIOENCODING=utf-8 python scripts/validate_quiz_packs.py || {
    echo "Pre-commit blocked: quiz pack validation failed." >&2
    exit 1
  }
fi

if [[ -n "$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(dart|yaml|arb)$' || true)" ]]; then
  echo "→ Running flutter analyze..."
  if ! flutter analyze --no-pub 2>&1 | tail -20; then
    echo "Pre-commit blocked: flutter analyze failed." >&2
    exit 1
  fi
fi

echo "✓ Pre-commit checks passed."
